# Ask Atharva — settings. You can change all of these from the Settings page too.

# Your name (used in greetings and the app title)
USER_NAME=Atharva

# Your time zone, used for "today", "tomorrow 3pm" and the calendar
TIMEZONE=Asia/Kolkata

# AI — add ONE key. Groq is free: https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional: a specific model (empty = openai/gpt-oss-120b on Groq, gpt-4o-mini on OpenAI)
MODEL=openai/gpt-oss-120b

# Where the app runs. Keep 127.0.0.1 so only this computer can open it.
HOST=127.0.0.1
PORT=8000

# --- Database & accounts ---
# MongoDB connection string. A free MongoDB Atlas cluster works: https://www.mongodb.com/atlas
# (Atlas -> Connect -> Drivers -> copy the mongodb+srv://... string and put your password in it)
MONGODB_URI=mongodb://askatharva:324887sn@ac-h6pdk5r-shard-00-00.zfqzpn9.mongodb.net:27017,ac-h6pdk5r-shard-00-01.zfqzpn9.mongodb.net:27017,ac-h6pdk5r-shard-00-02.zfqzpn9.mongodb.net:27017/?ssl=true&replicaSet=atlas-t6n19q-shard-0&authSource=admin&appName=Cluster0
# Signs the login cookie. Optional: if empty, one is generated and kept in the database.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=1xWHuzG8an0dhejO2gAUuEwEuFmOf7N4uAIN6S3Hq8be2CKltW00EyzfJr3PT0oGMmQFwQTXbuYjhqkyN8BfdwjqSCyok8WUarq3Vsh4NkrEBanjYQU95m9nKLxW3njjeY4MVD5D6ff1JdmtR0mbKJbuE6J10kFJz80gxVzgWDnfpJ1dR9JD67PaR2y4AXEr6enBxjy50cV2I78EVJU78VQ89rkCvyi5qLS7s8D2eETgNKai7PZCvTRFLRKubRie
# Set to false once your accounts exist, to stop new people signing up.
ALLOW_SIGNUP=true
